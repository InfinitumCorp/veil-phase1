index ca295f400aaf0b17dc579e8f88bf2e21639c8355..7d7c9e97cfb6362fdeccb7254e6c92deadb23897 100644
--- a/browser/branding/tb-release/locales/en-US/brand.ftl
+++ b/browser/branding/tb-release/locales/en-US/brand.ftl
@@ -1,18 +1,10 @@
-# For Tor Browser, we use a new file (different than the brand.ftl file
-# that is used by Firefox) to avoid picking up the -brand-short-name values
-# that Mozilla includes in the Firefox language packs.
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
-# The shortened application name for Tor Browser. Shared between versions.
--brand-shorter-name = Tor Browser
-# The default application name for the stable release.
--brand-short-name = Tor Browser
-# The full application name for the stable release.
--brand-full-name = Tor Browser
-# This brand name can be used in messages where the product name needs to
-# remain unchanged across different versions (Nightly, Beta, etc.).
--brand-product-name = Tor Browser
-# The name of the Tor Project organisation.
--vendor-short-name = Tor Project
-# "Tor" is a trademark names, so should not be translated (not including the quote marks, which can be localized).
-# "The Tor Project, Inc." is an organisation name.
-trademarkInfo = “Tor” and the Tor logo are registered trademarks of The Tor Project, Inc.
+-brand-shorter-name = VEIL
+-brand-short-name = VEIL
+-brand-full-name = VEIL
+-brand-product-name = VEIL
+-vendor-short-name = Infinitum Corporation
+trademarkInfo = VEIL is a trademark of Infinitum Corporation. Built on Tor Browser by The Tor Project; “Tor” and the Tor logo are registered trademarks of The Tor Project, Inc.

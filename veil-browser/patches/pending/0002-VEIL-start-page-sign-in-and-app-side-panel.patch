+/* @infinitum/i18n language switcher: white/black, hairline, no shadows or color.
+   No images or data: URIs, so it works under strict CSPs (img-src 'self'). */
+.lang-switch {
+  font: inherit;
+  font-size: 13px;
+  line-height: 1.2;
+  color: #000;
+  background-color: #fff;
+  border: 1px solid #000;
+  border-radius: 0;
+  padding: 4px 6px;
+  cursor: pointer;
+  max-width: 100%;
+}
+.lang-switch:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
+
+/* For apps without a natural header slot: a small fixed menu in the bottom corner. */
+.lang-float {
+  position: fixed;
+  inset-block-end: 12px;
+  inset-inline-start: 12px;
+  z-index: 40;
+}
+@media print { .lang-float { display: none; } }
diff --git a/browser/components/veil/content/i18n/i18n.js b/browser/components/veil/content/i18n/i18n.js
new file mode 100644
index 0000000000000000000000000000000000000000..55265841a58b67244a527172554b8b549dfbc551
--- /dev/null
+++ b/browser/components/veil/content/i18n/i18n.js
@@ -0,0 +1,311 @@
+// @infinitum/i18n runtime. One plain ES module, no dependencies, so it runs the
+// same in Vite/React apps, static HTML pages, Workers-served pages and Chrome
+// extensions. Standalone repos vendor this file unchanged (see README).
+//
+// Catalogs are generated at build time and committed with each app, so nothing
+// here fetches from the network: the UI works offline and in Russia without a VPN.
+
+/** Every language an Infinitum app ships. English is the source and the fallback. */
+export const LOCALES = [
+  { code: "en", name: "English", dir: "ltr" },
+  { code: "ru", name: "Русский", dir: "ltr" },
+  { code: "uk", name: "Українська", dir: "ltr" },
+  { code: "es", name: "Español", dir: "ltr" },
+  { code: "fr", name: "Français", dir: "ltr" },
+  { code: "de", name: "Deutsch", dir: "ltr" },
+  { code: "pt", name: "Português", dir: "ltr" },
+  { code: "zh", name: "中文", dir: "ltr" },
+  { code: "ar", name: "العربية", dir: "rtl" },
+];
+
+export const DEFAULT_STORAGE_KEY = "infinitum.lang";
+const RTL = new Set(["ar", "fa", "he", "ur"]);
+
+/** "pt-BR" -> "pt", "zh_Hans_CN" -> "zh". */
+export function baseLanguage(tag) {
+  return String(tag || "").trim().toLowerCase().replace("_", "-").split("-")[0];
+}
+
+export function directionOf(code) {
+  return RTL.has(baseLanguage(code)) ? "rtl" : "ltr";
+}
+
+function readStorage(key) {
+  try { return globalThis.localStorage?.getItem(key) ?? null; } catch { return null; }
+}
+function writeStorage(key, value) {
+  try {
+    if (value == null) globalThis.localStorage?.removeItem(key);
+    else globalThis.localStorage?.setItem(key, value);
+  } catch { /* private mode, blocked storage: the choice just isn't remembered */ }
+}
+
+/**
+ * Pick the UI language: a remembered manual choice, then `?lang=`, then the
+ * browser's preferred languages, then the fallback.
+ */
+export function detectLocale(options = {}) {
+  const supported = options.supported ?? LOCALES.map((l) => l.code);
+  const fallback = options.fallback ?? "en";
+  const key = options.storageKey ?? DEFAULT_STORAGE_KEY;
+  const pick = (tag) => {
+    const base = baseLanguage(tag);
+    return supported.includes(base) ? base : null;
+  };
+  const stored = pick(readStorage(key));
+  if (stored) return stored;
+  try {
+    const q = new URLSearchParams(globalThis.location?.search ?? "").get("lang");
+    if (pick(q)) return pick(q);
+  } catch { /* no location */ }
+  const nav = globalThis.navigator;
+  const prefs = options.languages ?? (nav ? (nav.languages?.length ? nav.languages : [nav.language]) : []);
+  for (const tag of prefs) {
+    const hit = pick(tag);
+    if (hit) return hit;
+  }
+  return fallback;
+}
+
+/** Replace `{name}` placeholders. Unknown placeholders are left as they are. */
+export function format(template, vars) {
+  if (!vars) return template;
+  return template.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
+}
+
+/**
+ * Create a translator.
+ *   const i18n = createI18n({ catalogs });   // catalogs = { en: {...}, ru: {...} }
+ *   i18n.t("nav.inbox"); i18n.setLocale("ar"); i18n.apply(document);
+ */
+export function createI18n(options) {
+  const catalogs = options.catalogs || {};
+  const fallback = options.fallback ?? "en";
+  const storageKey = options.storageKey ?? DEFAULT_STORAGE_KEY;
+  const supported = options.supported ?? LOCALES.map((l) => l.code).filter((c) => c === fallback || catalogs[c]);
+  const listeners = new Set();
+  let locale = options.locale && supported.includes(baseLanguage(options.locale))
+    ? baseLanguage(options.locale)
+    : detectLocale({ supported, fallback, storageKey });
+
+  const t = (key, vars) => {
+    const hit = catalogs[locale]?.[key] ?? catalogs[fallback]?.[key];
+    return format(hit ?? key, vars);
+  };
+
+  // Keys with {0}-style placeholders also match rendered text ("3 / 5 active agents").
+  const patternCache = new Map();
+  const patternsFor = (code) => {
+    if (!patternCache.has(code)) {
+      const list = [];
+      for (const [key, value] of Object.entries(catalogs[code] ?? {})) {
+        if (!/\{\d+\}/.test(key)) continue;
+        const src = key.replace(/[.*+?^$()|[\]\\]/g, "\\$&").replace(/\\?\{(\d+)\\?\}/g, "(?<p$1>.+?)").replace(/\{(\d+)\}/g, "(?<p$1>.+?)");
+        try { list.push([new RegExp(`^${src}$`, "s"), value]); } catch { /* skip odd keys */ }
+      }
+      patternCache.set(code, list);
+    }
+    return patternCache.get(code);
+  };
+  /** Translation of an exact English UI string in the current language, or null. */
+  const lookup = (text) => {
+    if (locale === fallback) return null;
+    const exact = catalogs[locale]?.[text];
+    if (exact != null) return exact;
+    for (const [re, value] of patternsFor(locale)) {
+      const m = re.exec(text);
+      if (m) return value.replace(/\{(\d+)\}/g, (s, n) => m.groups?.[`p${n}`] ?? s);
+    }
+    return null;
+  };
+
+  const i18n = {
+    get locale() { return locale; },
+    get dir() { return directionOf(locale); },
+    supported,
+    locales: LOCALES.filter((l) => supported.includes(l.code)),
+    t,
+    lookup,
+    has: (key) => Boolean(catalogs[locale]?.[key] ?? catalogs[fallback]?.[key]),
+    /** Switch language and remember the choice. `null` forgets it and follows the browser again. */
+    setLocale(code) {
+      let next;
+      if (code == null) {
+        writeStorage(storageKey, null);
+        next = detectLocale({ supported, fallback, storageKey });
+      } else {
+        next = baseLanguage(code);
+        if (!supported.includes(next)) return;
+        writeStorage(storageKey, next);
+      }
+      if (next === locale) return;
+      locale = next;
+      if (options.autoApply !== false && globalThis.document) i18n.apply(globalThis.document);
+      for (const fn of listeners) fn(locale);
+    },
+    /** Subscribe to language changes; returns an unsubscribe function. */
+    subscribe(fn) { listeners.add(fn); return () => listeners.delete(fn); },
+    /**
+     * Translate static markup:
+     *   <h1 data-i18n="home.title">Fallback</h1>
+     *   <input data-i18n-attr="placeholder:search.hint,aria-label:search.label">
+     *   <p data-i18n-html="legal.note">  (only for catalog strings you control)
+     * and set <html lang dir>.
+     */
+    apply(root) {
+      const doc = root?.ownerDocument ?? root;
+      const html = doc?.documentElement;
+      if (html) { html.lang = locale; html.dir = directionOf(locale); }
+      if (!root?.querySelectorAll) return;
+      for (const el of root.querySelectorAll("[data-i18n]")) {
+        const key = el.getAttribute("data-i18n");
+        if (i18n.has(key)) el.textContent = t(key);
+      }
+      for (const el of root.querySelectorAll("[data-i18n-html]")) {
+        const key = el.getAttribute("data-i18n-html");
+        if (i18n.has(key)) el.innerHTML = t(key);
+      }
+      for (const el of root.querySelectorAll("[data-i18n-attr]")) {
+        for (const pair of el.getAttribute("data-i18n-attr").split(",")) {
+          const [attr, key] = pair.split(":").map((s) => s.trim());
+          if (attr && key && i18n.has(key)) el.setAttribute(attr, t(key));
+        }
+      }
+    },
+  };
+  if (options.autoApply !== false && globalThis.document?.documentElement) {
+    globalThis.document.documentElement.lang = locale;
+    globalThis.document.documentElement.dir = directionOf(locale);
+  }
+  return i18n;
+}
+
+const UI_ATTRS = ["placeholder", "title", "aria-label", "alt", "label", "aria-description"];
+const SKIP_TAGS = new Set(["SCRIPT", "STYLE", "CODE", "PRE", "TEXTAREA", "NOSCRIPT", "KBD", "SAMP", "svg"]);
+
+/**
+ * Translate rendered markup in place, using catalogs keyed by the English text
+ * (extracted at build time by scripts/extract.ts). Watches the subtree, so text
+ * that views render later is translated too, and re-translates on language change.
+ * Anything inside `translate="no"`, contenteditable, code or form values is left
+ * alone: mark user content (mail bodies, chat, AI output) with translate="no".
+ */
+export function translateDom(i18n, root = globalThis.document?.body) {
+  if (!root) return { stop() {} };
+  const doc = root.ownerDocument ?? root;
+  const sourceText = new WeakMap();   // Text -> English source
+  const shownText = new WeakMap();    // Text -> value we last wrote
+  const sourceAttr = new WeakMap();   // Element -> { attr: English }
+  const skipped = (el) => {
+    for (let e = el; e && e.nodeType === 1; e = e.parentElement) {
+      if (SKIP_TAGS.has(e.tagName) || e.getAttribute("translate") === "no" || e.isContentEditable) return true;
+    }
+    return false;
+  };
+  const split = (s) => /^(\s*)([\s\S]*?)(\s*)$/.exec(s);
+  const doText = (node) => {
+    const cur = node.nodeValue;
+    if (shownText.get(node) !== cur) sourceText.set(node, cur);
+    const src = sourceText.get(node);
+    const [, lead, core, trail] = split(src);
+    if (!core || !/\p{L}/u.test(core) || skipped(node.parentElement)) return;
+    const tr = i18n.lookup(core.replace(/\s+/g, " "));
+    const next = tr == null ? src : lead + tr + trail;
+    shownText.set(node, next);
+    if (next !== cur) node.nodeValue = next;
+  };
+  // A <textarea>'s or <code>'s contents are skipped, but its own placeholder/title
+  // are still UI; only translate="no" and contenteditable opt the element out.
+  const attrsSkipped = (el) => el.getAttribute("translate") === "no" || el.isContentEditable || skipped(el.parentElement);
+  const doAttrs = (el) => {
+    if (attrsSkipped(el)) return;
+    let src = sourceAttr.get(el);
+    for (const a of UI_ATTRS) {
+      if (!el.hasAttribute(a)) continue;
+      const cur = el.getAttribute(a);
+      if (!src) { src = {}; sourceAttr.set(el, src); }
+      const known = src[a];
+      if (known == null || (cur !== known.shown)) src[a] = { en: cur, shown: cur };
+      const tr = i18n.lookup(src[a].en.trim());
+      const next = tr ?? src[a].en;
+      src[a].shown = next;
+      if (next !== cur) el.setAttribute(a, next);
+    }
+  };
+  const walk = (node) => {
+    if (node.nodeType === 3) { doText(node); return; }
+    if (node.nodeType !== 1 && node.nodeType !== 9 && node.nodeType !== 11) return;
+    if (node.nodeType === 1) { doAttrs(node); if (skipped(node)) return; }
+    const tw = doc.createTreeWalker(node, 5 /* ELEMENT | TEXT */, {
+      acceptNode: (n) => {
+        if (n.nodeType !== 1) return 1;
+        if (SKIP_TAGS.has(n.tagName)) { doAttrs(n); return 2; }
+        return n.getAttribute("translate") === "no" || n.isContentEditable ? 2 : 1;
+      },
+    });
+    for (let n = tw.nextNode(); n; n = tw.nextNode()) {
+      if (n.nodeType === 3) doText(n); else doAttrs(n);
+    }
+  };
+  let titleSource = doc.title;
+  let titleShown = doc.title;
+  const doTitle = () => {
+    if (doc.title !== titleShown) titleSource = doc.title;
+    titleShown = i18n.lookup(titleSource) ?? titleSource;
+    if (doc.title !== titleShown) doc.title = titleShown;
+  };
+  const run = () => { doTitle(); walk(root); };
+  run();
+  const Observer = globalThis.MutationObserver;
+  const mo = Observer ? new Observer((records) => {
+    for (const r of records) {
+      if (r.type === "characterData") doText(r.target);
+      else if (r.type === "attributes") doAttrs(r.target);
+      else for (const n of r.addedNodes) walk(n);
+    }
+  }) : null;
+  mo?.observe(root, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: UI_ATTRS });
+  const off = i18n.subscribe(run);
+  return { stop() { mo?.disconnect(); off(); }, refresh: run };
+}
+
+/**
+ * One call for most apps: detect the language, translate the page, and (when
+ * `switcher` is an element or selector) mount the language menu into it.
+ */
+export function startI18n(options) {
+  const i18n = createI18n(options);
+  const doc = globalThis.document;
+  if (doc) {
+    const go = () => {
+      i18n.dom = translateDom(i18n, options.root ?? doc.body);
+      const host = typeof options.switcher === "string" ? doc.querySelector(options.switcher) : options.switcher;
+      // No menu until there is a second language to choose.
+      if (host && i18n.locales.length > 1) host.append(languageSwitcher(i18n, { label: i18n.lookup("Language") ?? "Language" }));
+    };
+    if (doc.readyState === "loading") doc.addEventListener("DOMContentLoaded", go, { once: true }); else go();
+  }
+  return i18n;
+}
+
+/**
+ * A plain <select> language switcher. It inherits the app's font and colors and
+ * is styled by the `.lang-switch` rules in i18n.css (white/black, hairline border).
+ */
+export function languageSwitcher(i18n, options = {}) {
+  const doc = options.document ?? globalThis.document;
+  const select = doc.createElement("select");
+  select.className = options.className ?? "lang-switch";
+  select.setAttribute("aria-label", options.label ?? "Language");
+  for (const l of i18n.locales) {
+    const opt = doc.createElement("option");
+    opt.value = l.code;
+    opt.textContent = l.name;
+    opt.lang = l.code;
+    if (l.code === i18n.locale) opt.selected = true;
+    select.append(opt);
+  }
+  select.addEventListener("change", () => i18n.setLocale(select.value));
+  i18n.subscribe((code) => { select.value = code; });
+  return select;
+}
diff --git a/browser/components/veil/content/i18n/start.js b/browser/components/veil/content/i18n/start.js
new file mode 100644
index 0000000000000000000000000000000000000000..b8fa67fcf9f8b0f41a607d9ebd1479d481682042
--- /dev/null
+++ b/browser/components/veil/content/i18n/start.js
@@ -0,0 +1,16 @@
+// Interface language: detected from the browser, remembered when chosen from the
+// menu, English fallback. Catalogs are generated at build time with
+// infinitum-nexus packages/i18n (extract.ts + translate.ts) and committed here, so
+// nothing is translated at runtime and the page works offline and in Russia.
+// i18n.js and i18n.css are vendored unchanged from that package.
+import { startI18n } from './i18n.js';
+import catalogs from './catalogs.js';
+
+let slot = document.getElementById('lang-switch');
+if (!slot) {
+  slot = document.createElement('div');
+  slot.className = 'lang-float';
+  document.body.append(slot);
+}
+export const i18n = startI18n({ catalogs, switcher: slot });
+export const t = i18n.t;
diff --git a/browser/components/veil/content/shared/bridge.js b/browser/components/veil/content/shared/bridge.js
new file mode 100644
index 0000000000000000000000000000000000000000..3ed7376f6579e751b6d39ef4e2058f5901664b56
--- /dev/null
+++ b/browser/components/veil/content/shared/bridge.js
@@ -0,0 +1,65 @@
+/* Bridge between a VEIL dashboard page and the browser.
+ *
+ * In the shipped browser these pages are privileged about: pages, and the
+ * 0002 chrome patch exposes Firefox's RemotePageManager functions
+ * (RPMSendAsyncMessage / RPMAddMessageListener) to them. Outside the browser
+ * (design preview, tests) the bridge falls back to a preview mode that never
+ * touches the network.
+ *
+ * Messages are a fixed allow-list: a dashboard can ask for status and
+ * request user-visible actions, nothing else.
+ */
+"use strict";
+
+const VeilBridge = (() => {
+  const OUTGOING = new Set([
+    "VEIL:GetTorStatus",
+    "VEIL:NewIdentity",
+    "VEIL:NewCircuit",
+    "VEIL:GetBookmarks",
+    "VEIL:OpenSignIn",
+    "VEIL:OpenAppPanel",
+    "VEIL:GetAccount",
+  ]);
+  const INCOMING = new Set(["VEIL:TorStatus", "VEIL:Bookmarks", "VEIL:Account"]);
+
+  const native =
+    typeof RPMSendAsyncMessage === "function" &&
+    typeof RPMAddMessageListener === "function";
+
+  const listeners = new Map();
+
+  function send(name, data = {}) {
+    if (!OUTGOING.has(name)) throw new Error(`VEIL bridge: message not allowed: ${name}`);
+    if (native) {
+      RPMSendAsyncMessage(name, data);
+      return;
+    }
+    preview(name);
+  }
+
+  function on(name, fn) {
+    if (!INCOMING.has(name)) throw new Error(`VEIL bridge: listener not allowed: ${name}`);
+    if (!listeners.has(name)) {
+      listeners.set(name, []);
+      if (native) RPMAddMessageListener(name, msg => emit(name, msg.data));
+    }
+    listeners.get(name).push(fn);
+  }
+
+  function emit(name, data) {
+    for (const fn of listeners.get(name) || []) fn(data);
+  }
+
+  // Preview mode: fixed, local answers so the page can be designed and
+  // tested in any browser without a VEIL build.
+  function preview(name) {
+    queueMicrotask(() => {
+      if (name === "VEIL:GetTorStatus") emit("VEIL:TorStatus", { state: "preview" });
+      if (name === "VEIL:GetBookmarks") emit("VEIL:Bookmarks", { items: [] });
+      if (name === "VEIL:GetAccount") emit("VEIL:Account", { signedIn: false });
+    });
+  }
+
+  return { send, on, native };
+})();
diff --git a/browser/components/veil/content/shared/veil.css b/browser/components/veil/content/shared/veil.css
new file mode 100644
index 0000000000000000000000000000000000000000..1bdad7f7b6f025e927d9113e9f9132c68e44a986
--- /dev/null
+++ b/browser/components/veil/content/shared/veil.css
@@ -0,0 +1,165 @@
+/* VEIL start pages: white, quiet, nothing loaded from the network.
+   Typography follows infinitum-corporation.vercel.app: Helvetica Neue at a
+   regular weight with tight tracking on headlines. It is a system font, so
+   nothing is downloaded; app icons are drawn in CSS, never fetched. */
+:root {
+  --bg: #ffffff;
+  --ink: #111820;
+  --ink-quiet: #6b6b74;
+  --rule: #e8e8ec;
+  --hover: #f3f3f5;
+  --focus: #1f5fd6;
+  --font: "Helvetica Neue", Helvetica, Arial, sans-serif;
+}
+/* The one coloured element: the small dot beside "Anonymous". */
+:root { --accent: #5b3fd1; }
+@media (prefers-contrast: more) { :root { --ink-quiet: var(--ink); --rule: #9a9aa3; } }
+
+* { box-sizing: border-box; }
+html, body { margin: 0; background: var(--bg); }
+body {
+  color: var(--ink); font: 15px/1.5 var(--font);
+  min-height: 100vh; display: flex; flex-direction: column;
+}
+:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
+button { font: inherit; color: inherit; cursor: pointer; }
+
+/* ---- top bar -------------------------------------------------------- */
+.topbar {
+  display: flex; align-items: center; flex-wrap: wrap; gap: 0 12px;
+  min-height: 52px; padding: 0 14px; border-bottom: 1px solid var(--rule);
+}
+/* Brand mark, top left, as the Infinitum logo sits on the site. */
+.brand {
+  display: inline-flex; align-items: center; height: 52px; flex: none;
+  font-size: 19px; letter-spacing: -0.04em; color: var(--ink); white-space: nowrap;
+}
+/* Top right: Mail, Apps, Sign In — words in the site's navigation style. */
+.top-links { display: flex; align-items: center; gap: 22px; }
+.nav-link {
+  position: relative; padding: 8px 0; font: inherit; font-size: 13px; color: var(--ink);
+  text-decoration: none; white-space: nowrap; background: none; border: 0; cursor: pointer;
+}
+.nav-link::after {
+  content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
+  background: var(--ink); transform: scaleX(0); transition: transform .15s ease;
+}
+.nav-link:hover::after, .nav-link:focus-visible::after, .nav-link[aria-expanded="true"]::after { transform: scaleX(1); }
+.nav-link[hidden] { display: none; }
+
+/* The Apps menu, under its word. */
+.apps-menu { position: relative; }
+.apps-panel {
+  position: absolute; top: 40px; right: -12px; z-index: 10; width: 300px;
+  display: flex; flex-direction: column; padding: 8px;
+  background: #fff; border: 1px solid var(--rule); border-radius: 4px;
+  box-shadow: 0 8px 28px rgba(17, 24, 32, .12);
+}
+.apps-panel[hidden] { display: none; }
+.menu-app { display: flex; flex-direction: column; gap: 1px; padding: 9px 12px; border-radius: 3px; color: var(--ink); text-decoration: none; }
+.menu-app:hover, .menu-app:focus-visible { background: var(--hover); }
+.menu-app-name { font-size: 14px; }
+.menu-app-summary { font-size: 12px; color: var(--ink-quiet); }
+
+/* "Sign In", top right: a word in the site's navigation style, darker
+   than the app names so it reads as the page's one action. */
+.signin {
+  position: relative; padding: 8px 0; font-size: 13px; color: var(--ink);
+  text-decoration: none; white-space: nowrap; flex: none; cursor: pointer;
+}
+.signin::after {
+  content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
+  background: var(--ink); transform: scaleX(0); transition: transform .15s ease;
+}
+.signin:hover::after, .signin:focus-visible::after { transform: scaleX(1); }
+.signin[hidden] { display: none; }
+
+/* Workspace label, centred just under the search box. */
+.workspace-strip { display: flex; justify-content: center; margin-top: 16px; }
+.workspace {
+  display: inline-flex; align-items: center; gap: 8px;
+  font-size: 12px; font-weight: 400; color: var(--ink); white-space: nowrap;
+}
+.workspace::before {
+  content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex: none;
+}
+.spacer { flex: 1; }
+
+/* App names along the bottom, above the footer, styled like the Infinitum
+   site navigation: 13px regular words in muted slate, darkening with a 2px
+   underline on hover. */
+.apps {
+  display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
+  gap: 4px 22px; padding: 0 14px 14px;
+}
+.app-link {
+  position: relative; padding: 8px 0; font-size: 13px; color: #49545e;
+  text-decoration: none; white-space: nowrap; flex: none;
+}
+.app-link::after {
+  content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
+  background: var(--ink); transform: scaleX(0); transition: transform .15s ease;
+}
+.app-link:hover, .app-link:focus-visible { color: var(--ink); }
+.app-link:hover::after, .app-link:focus-visible::after { transform: scaleX(1); }
+
+.text-button {
+  border: 0; background: none; padding: 6px 10px; border-radius: 2px;
+  font-size: 12px; color: var(--ink-quiet); white-space: nowrap; flex: none;
+}
+.text-button:hover { background: var(--hover); color: var(--ink); }
+/* Outlined button, as in the site's "Let's talk". */
+.outline-button {
+  border: 1px solid var(--ink); background: #fff; padding: 7px 14px; border-radius: 2px;
+  font-size: 12px; color: var(--ink); white-space: nowrap; flex: none;
+}
+.outline-button:hover { background: var(--ink); color: #fff; }
+
+/* ---- centre --------------------------------------------------------- */
+main {
+  flex: 1; width: min(620px, 100% - 32px); margin: 0 auto;
+  display: flex; flex-direction: column; justify-content: center; padding: 48px 0 80px;
+}
+.search input {
+  width: 100%; font: inherit; font-size: 16px; padding: 14px 16px;
+  border: 1px solid var(--rule); border-radius: 2px; background: #fff; color: var(--ink);
+}
+.search input:focus { outline: none; border-color: var(--ink); }
+
+.status {
+  display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
+  gap: 6px 14px; margin-top: 8px; font-size: 12px; color: var(--ink-quiet);
+}
+.status-line { display: inline-flex; align-items: center; gap: 7px; }
+.dot { width: 7px; height: 7px; border-radius: 50%; background: #b5b5bd; }
+.status[data-state="connected"] .dot { background: #1f9d55; }
+.status[data-state="connecting"] .dot { background: #d29a00; }
+.status[data-state="error"] .dot, .status[data-state="blocked"] .dot { background: #d1342f; }
+
+.bookmarks { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 32px; }
+.bookmark {
+  font-size: 12px; padding: 6px 12px; border-radius: 2px; border: 1px solid var(--rule);
+  color: var(--ink); text-decoration: none; max-width: 200px;
+  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+}
+.bookmark:hover { background: var(--hover); }
+
+footer {
+  display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px 16px;
+  margin: 0 14px; padding: 14px 0; border-top: 1px solid var(--rule);
+  font-size: 12px; color: var(--ink);
+}
+footer .quiet { color: var(--ink-quiet); }
+.footer-right { display: inline-flex; align-items: center; gap: 18px; }
+.footer-link { color: var(--ink); text-decoration: none; }
+.footer-link:hover, .footer-link:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
+.footer-links { display: inline-flex; gap: 18px; }
+.footer-links:empty { display: none; }
+
+@media (max-width: 560px) {
+  .topbar { padding: 0 8px; gap: 6px; }
+  .top-links { gap: 16px; }
+  .apps-panel { width: min(300px, 100vw - 16px); }
+  .apps { gap: 2px 18px; }
+  footer { justify-content: flex-start; }
+}
diff --git a/browser/components/veil/content/veil-browser.css b/browser/components/veil/content/veil-browser.css
new file mode 100644
index 0000000000000000000000000000000000000000..7cc74fbb4f7902f7913840f56c3b957d160e7d36
--- /dev/null
+++ b/browser/components/veil/content/veil-browser.css
@@ -0,0 +1,28 @@
+/* VEIL's clean toolbar (patch 0001, [branding]): one row of tabs, then back,
+   forward, reload, the address bar, New identity and the menu. Everything
+   else stays reachable from the menu. Browser chrome only: nothing here is
+   visible to web content, so it doesn't affect fingerprinting. */
+
+/* Hide the bookmarks toolbar and the extra buttons Tor Browser shows. */
+#PersonalToolbar { visibility: collapse !important; }
+#home-button, #downloads-button, #fxa-toolbar-menu-button,
+#security-level-button, #new-circuit-button, #library-button,
+#sidebar-button, #unified-extensions-button { display: none !important; }
+
+/* Address bar: a soft rounded field, white with a dark ring when focused. */
+#urlbar-background { border-radius: 18px !important; background-color: #eef0f3 !important; border: 0 !important; }
+#urlbar[focused] > #urlbar-background { background-color: #fff !important; outline: 2px solid #111820 !important; outline-offset: -2px; }
+#urlbar-input { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
+
+/* The "Anonymous" chip at the left of the address bar. */
+#veil-anonymous-chip {
+  display: flex; align-items: center; gap: 7px; height: 26px; margin-inline: 4px 8px; padding-inline: 9px 11px;
+  border-radius: 13px; background: #fff; color: #111820; font: 12.5px "Helvetica Neue", Helvetica, Arial, sans-serif;
+}
+#veil-anonymous-chip::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #5b3fd1; }
+
+/* Side panel (VeilSidePanel). */
+#veil-panel { width: 420px; min-width: 320px; max-width: 720px; border-inline-start: 1px solid #e3e4e8; background: #fff; }
+#veil-panel-bar { min-height: 34px; padding-inline: 6px; background: #eef0f3; }
+#veil-panel-splitter { width: 5px; margin-inline-start: -2px; border: 0; background: transparent; }
+#veil-panel-splitter:hover { background: #e3e4e8; }

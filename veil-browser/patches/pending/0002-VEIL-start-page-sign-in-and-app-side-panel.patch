+      <div class="apps-menu">
+        <button type="button" class="nav-link" id="apps-button" aria-haspopup="true" aria-expanded="false" aria-controls="apps-panel" hidden>Apps</button>
+        <div class="apps-panel" id="apps-panel" translate="no" role="menu" aria-label="Infinitum apps" hidden></div>
+      </div>
+      <!-- Opens Cumulus://ID sign-in in a new tab, over Tor. The address comes
+           from the signed app list, never from this page. -->

diff --git a/browser/components/veil/AboutVeilHomeParent.sys.mjs b/browser/components/veil/AboutVeilHomeParent.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b4136d17709bacf5524092e01788616e2b57a605
--- /dev/null
+++ b/browser/components/veil/AboutVeilHomeParent.sys.mjs
@@ -0,0 +1,85 @@
+/* about:veil-home, parent side (patch 0002).
+ *
+ * Answers the start page's bridge messages. The page can only send the
+ * messages listed in RemotePageAccessManager for about:veil-home (see
+ * PATCH-NOTES.md), and every handler takes addresses from VEIL's own
+ * registry, never from the page.
+ */
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  PlacesUtils: "resource://gre/modules/PlacesUtils.sys.mjs",
+  TorConnect: "moz-src:///toolkit/modules/TorConnect.sys.mjs",
+  TorDomainIsolator: "moz-src:///toolkit/components/tor-launcher/TorDomainIsolator.sys.mjs",
+  VeilBrowser: "moz-src:///browser/components/veil/VeilBrowser.sys.mjs",
+  VeilSignIn: "moz-src:///browser/components/veil/VeilSignIn.sys.mjs",
+});
+
+// TorConnectStage names (toolkit/modules/TorConnect.sys.mjs, ESR 153) -> the
+// three states the start page shows. Anything else is still connecting.
+const TOR_STATES = {
+  Bootstrapped: "connected",
+  Offline: "error",
+  FinalError: "error",
+  ProviderStopped: "error",
+  RegionNotFound: "error",
+};
+
+export class AboutVeilHomeParent extends JSWindowActorParent {
+  #unsubscribe = null;
+
+  actorCreated() {
+    this.#unsubscribe = lazy.VeilSignIn.subscribe(account => this.#send("VEIL:Account", account));
+  }
+
+  didDestroy() {
+    this.#unsubscribe?.();
+  }
+
+  #send(name, data) {
+    try { this.sendAsyncMessage(name, data); } catch { /* page already gone */ }
+  }
+
+  get #window() {
+    return this.browsingContext.topChromeWindow;
+  }
+
+  async receiveMessage({ name, data }) {
+    switch (name) {
+      case "VEIL:GetTorStatus": {
+        const state = TOR_STATES[lazy.TorConnect.stageName] || "connecting";
+        this.#send("VEIL:TorStatus", { state });
+        break;
+      }
+      case "VEIL:GetBookmarks": {
+        const tree = await lazy.PlacesUtils.promiseBookmarksTree(lazy.PlacesUtils.bookmarks.toolbarGuid);
+        const items = (tree.children || []).filter(c => c.uri && /^https?:/.test(c.uri)).slice(0, 12)
+          .map(c => ({ title: c.title || "", url: c.uri }));
+        this.#send("VEIL:Bookmarks", { items });
+        break;
+      }
+      case "VEIL:GetAccount":
+        this.#send("VEIL:Account", lazy.VeilSignIn.account());
+        break;
+      case "VEIL:OpenSignIn":
+        await lazy.VeilSignIn.open({
+          registry: lazy.VeilBrowser.registry,
+          cumulusId: lazy.VeilBrowser.cumulusId(),
+          openTab: url => {
+            const gBrowser = this.#window.gBrowser;
+            gBrowser.selectedTab = gBrowser.addTrustedTab(url);
+          },
+        });
+        break;
+      case "VEIL:OpenAppPanel":
+        // Only the id is used; VeilAppPanel looks the address up in the registry.
+        lazy.VeilBrowser.appPanelFor(this.#window)?.handle({ name, data: { id: data?.id } });
+        break;
+      case "VEIL:NewIdentity":
+        this.#window.NewIdentityButton?.onCommand();      // Tor Browser's own New Identity
+        break;
+      case "VEIL:NewCircuit":
+        lazy.TorDomainIsolator.newCircuitForBrowser(this.#window.gBrowser.selectedBrowser);
+        break;
+    }
+  }
+}
diff --git a/browser/components/veil/VeilAppPanel.sys.mjs b/browser/components/veil/VeilAppPanel.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..fb86d57bfdbfc45199d01e80f0a7e3c994d572fc
--- /dev/null
+++ b/browser/components/veil/VeilAppPanel.sys.mjs
@@ -0,0 +1,120 @@
+/* VEIL app panel: Infinitum apps run in a side panel, like ChatGPT's sidebar.
+ *
+ * Clicking /CNDCTR/ or SCALVS.ai on the start page opens that app in a panel
+ * docked to the right of the window, next to whatever page the user is on,
+ * instead of navigating away. Clicking the same app again closes the panel;
+ * clicking the other app switches the panel to it.
+ *
+ * Security rules this module enforces:
+ *  - The start page sends only an app id. The address comes from the signed
+ *    app registry bundled with the browser, never from the page, so a
+ *    spoofed page cannot load a look-alike app into the panel.
+ *  - Only https:// addresses with no embedded credentials are loaded.
+ *  - The panel is an ordinary web content browser: it goes over Tor like
+ *    every other connection, and New Identity closes it and clears its
+ *    session with everything else.
+ *
+ * Browser glue (patch 0002, [chrome]) supplies a `panel` object backed by a
+ * remote <browser> element in the sidebar box:
+ *   panel.show({ url, title })  load url and show the panel
+ *   panel.hide()                hide the panel and unload its page
+ *   panel.setWidth(px)          resize the panel
+ * and calls VeilAppPanel.handle(message) for "VEIL:OpenAppPanel".
+ */
+
+export class AppPanelError extends Error {}
+
+export const DEFAULT_WIDTH = 420;
+export const MIN_WIDTH = 320;
+export const MAX_WIDTH = 720;
+
+const LOOPBACK = new Set(["localhost", "127.0.0.1", "[::1]"]);
+
+/**
+ * Look up an app in a verified registry and return its safe address.
+ * allowLoopbackHttp lets the local prototype use http://localhost; the real
+ * browser never sets it.
+ */
+export function appEntry(registry, id, { allowLoopbackHttp = false } = {}) {
+  const apps = registry && Array.isArray(registry.apps) ? registry.apps : [];
+  const app = apps.find(a => a && a.id === id);
+  if (!app) throw new AppPanelError(`no app with id '${id}' in this build`);
+  if (app.panel !== true) throw new AppPanelError(`app '${id}' doesn't open in the side panel`);
+  let url;
+  try {
+    url = new URL(app.url);
+  } catch {
+    throw new AppPanelError(`app '${id}' has an invalid address`);
+  }
+  const loopbackOk = allowLoopbackHttp && url.protocol === "http:" && LOOPBACK.has(url.hostname);
+  if (url.protocol !== "https:" && !loopbackOk) throw new AppPanelError(`app '${id}' must use https`);
+  if (url.username || url.password) throw new AppPanelError(`app '${id}' address must not carry credentials`);
+  return { id: app.id, title: app.name, url: url.href };
+}
+
+export const clampWidth = px =>
+  Math.min(MAX_WIDTH, Math.max(MIN_WIDTH, Math.round(Number.isFinite(px) ? px : DEFAULT_WIDTH)));
+
+export class AppPanel {
+  constructor({ registry, panel, allowLoopbackHttp = false }) {
+    this.registry = registry;
+    this.loopback = { allowLoopbackHttp };
+    this.panel = panel;
+    this.openId = null;
+    this.width = DEFAULT_WIDTH;
+  }
+
+  /** Open an app, switch to it, or close it if it is already open. */
+  toggle(id) {
+    if (this.openId === id) {
+      this.close();
+      return null;
+    }
+    const entry = appEntry(this.registry, id, this.loopback);
+    if (this.openId === null) this.panel.setWidth(this.width);
+    this.panel.show({ url: entry.url, title: entry.title });
+    this.openId = id;
+    return entry;
+  }
+
+  /**
+   * Open an app with a prompt typed in the address bar (VeilAppCommands).
+   * Always opens (never toggles closed); the prompt rides in the URL
+   * fragment, which is never sent to a server.
+   */
+  openWithPrompt(id, prompt) {
+    const entry = appEntry(this.registry, id, this.loopback);
+    const url = new URL(entry.url);
+    url.hash = prompt ? `prompt=${encodeURIComponent(prompt)}` : "";
+    if (this.openId === null) this.panel.setWidth(this.width);
+    this.panel.show({ url: url.href, title: entry.title });
+    this.openId = id;
+    return { ...entry, url: url.href };
+  }
+
+  close() {
+    if (this.openId === null) return;
+    this.panel.hide();
+    this.openId = null;
+  }
+
+  /** The user dragged the panel edge. */
+  resize(px) {
+    this.width = clampWidth(px);
+    if (this.openId !== null) this.panel.setWidth(this.width);
+    return this.width;
+  }
+
+  /** New Identity closes the panel along with every other session. */
+  onNewIdentity() {
+    this.close();
+  }
+
+  /** Entry point for the start page's bridge message. */
+  handle(message) {
+    if (!message || message.name !== "VEIL:OpenAppPanel") return null;
+    const id = message.data && message.data.id;
+    if (typeof id !== "string") throw new AppPanelError("message carries no app id");
+    return this.toggle(id);
+  }
+}
diff --git a/browser/components/veil/VeilBrowser.sys.mjs b/browser/components/veil/VeilBrowser.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ed5f98e7bc4c3cfdff0cfe6132fe5e834411f26d
--- /dev/null
+++ b/browser/components/veil/VeilBrowser.sys.mjs
@@ -0,0 +1,118 @@
+/* VEIL browser hub: wires VEIL's modules into Tor Browser (patches 0002-0006).
+ *
+ * Called from Tor Browser (patch 0002):
+ *   VeilBrowser.init()               BrowserGlue._beforeUIStartup, before any window
+ *   VeilBrowser.onWindowLoaded(win)  browser-init.js onLoad, for each browser window
+ *
+ * The address-bar provider for @scalvs / @cndctr is registered by Firefox's
+ * own provider list (UrlbarProvidersManager, patch 0006), not from here.
+ *
+ * Responsibilities:
+ *  - load the signed app registry bundled with the browser;
+ *  - start the anonymity guard (fail closed if Tor settings are weakened);
+ *  - give each window its side panel and a VeilAppPanel driving it;
+ *  - keep the address bar's "Anonymous" chip in step with sign-in;
+ *  - run Cumulus://ID sign-in, catching the redirect before it is sent;
+ *  - forget everything VEIL keeps (sign-in, panels) on New Identity.
+ */
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  AppPanel: "moz-src:///browser/components/veil/VeilAppPanel.sys.mjs",
+  CumulusID: "moz-src:///browser/components/veil/VeilCumulusID.sys.mjs",
+  VeilSignIn: "moz-src:///browser/components/veil/VeilSignIn.sys.mjs",
+  createSidePanel: "moz-src:///browser/components/veil/VeilSidePanel.sys.mjs",
+});
+
+// Verified and written into the tree at build time by registry_tool.py build.
+const REGISTRY_URL = "chrome://browser/content/veil/generated/registry.json";
+// Tor Browser's NewIdentityButton announces New Identity on this topic.
+const NEW_IDENTITY_TOPIC = "new-identity-requested";
+
+const panels = new WeakMap();      // window -> AppPanel
+let registry = { apps: [] };
+let cumulusId = null;
+
+function loadRegistry() {
+  const xhr = new XMLHttpRequest();          // chrome:// is local and synchronous-safe at startup
+  xhr.open("GET", REGISTRY_URL, false);
+  xhr.overrideMimeType("application/json");
+  xhr.send();
+  return JSON.parse(xhr.responseText);
+}
+
+/** Catch the Cumulus://ID redirect before the request leaves the browser. */
+const redirectObserver = {
+  observe(subject) {
+    if (!cumulusId || !cumulusId.enabled) return;
+    const channel = subject.QueryInterface(Ci.nsIHttpChannel);
+    const url = channel.URI.spec;
+    if (!cumulusId.isRedirect(url)) return;
+    channel.cancel(Cr.NS_BINDING_ABORTED);    // the code never goes to any server
+    const browser = channel.loadInfo?.browsingContext?.top?.embedderElement;
+    const win = browser?.ownerGlobal;
+    const tab = win?.gBrowser?.getTabForBrowser(browser);
+    if (tab) win.gBrowser.removeTab(tab);
+    lazy.VeilSignIn.finish({ cumulusId, address: url }).catch(err => {
+      Services.obs.notifyObservers(null, "veil-sign-in-failed", err.message);
+    });
+  },
+};
+
+export const VeilBrowser = {
+  get registry() {
+    return registry;
+  },
+
+  init() {
+    registry = loadRegistry();
+    cumulusId = new lazy.CumulusID({
+      registry,
+      openTab: (url, opts) => {
+        const win = Services.wm.getMostRecentBrowserWindow();
+        win.gBrowser.selectedTab = win.gBrowser.addTrustedTab(url, opts);
+      },
+      // The parent process's fetch goes through Tor like everything else.
+      fetch: (url, init) => fetch(url, init),
+    });
+    Services.obs.addObserver(redirectObserver, "http-on-modify-request");
+    Services.obs.addObserver(() => this.onNewIdentity(), NEW_IDENTITY_TOPIC);
+  },
+
+  onWindowLoaded(win) {
+    let appPanel;
+    const side = lazy.createSidePanel(win, {
+      onClose: () => appPanel.close(),
+      onOpenInTab: () => {
+        const app = registry.apps.find(a => a.id === appPanel.openId);
+        appPanel.close();
+        if (app) win.gBrowser.selectedTab = win.gBrowser.addTrustedTab(app.url);
+      },
+      onResize: px => appPanel.resize(px),
+    });
+    appPanel = new lazy.AppPanel({ registry, panel: side });
+    panels.set(win, appPanel);
+
+    // The "Anonymous" chip: anonymous unless signed in to Cumulus://ID.
+    const chip = win.document.getElementById("veil-anonymous-chip");
+    if (chip) {
+      const unsubscribe = lazy.VeilSignIn.subscribe(account => {
+        chip.textContent = account ? "Signed in" : "Anonymous";
+        chip.toggleAttribute("signed-in", !!account);
+      });
+      win.addEventListener("unload", unsubscribe, { once: true });
+    }
+  },
+
+  appPanelFor(win) {
+    return panels.get(win);
+  },
+
+  cumulusId() {
+    return cumulusId;
+  },
+
+  onNewIdentity() {
+    for (const win of Services.wm.getEnumerator("navigator:browser")) panels.get(win)?.onNewIdentity();
+    lazy.VeilSignIn.onNewIdentity(cumulusId);
+  },
+};
diff --git a/browser/components/veil/VeilCumulusID.sys.mjs b/browser/components/veil/VeilCumulusID.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..fb2c7887f652eba45d4a04c5f0fa0f845aa43134
--- /dev/null
+++ b/browser/components/veil/VeilCumulusID.sys.mjs
@@ -0,0 +1,214 @@
+/* VEIL sign-in with Cumulus://ID.
+ *
+ * "Sign In" on the start page runs a standard OpenID Connect sign-in
+ * (authorization code flow with PKCE, RFC 7636) against Cumulus://ID:
+ *
+ *   1. VEIL opens the Cumulus://ID sign-in page in a new tab. The user signs
+ *      in there, on Cumulus://ID's own page, so VEIL never sees a password.
+ *   2. Cumulus://ID redirects the tab to VEIL's redirect address with a
+ *      one-time code. The browser catches that navigation before it loads,
+ *      closes the tab and hands the address to handleRedirect().
+ *   3. VEIL exchanges the code (plus the PKCE secret only it knows) for an ID
+ *      token at the token endpoint, checks the token, and shows the user as
+ *      signed in.
+ *
+ * Anonymity: every request above goes over Tor, so Cumulus://ID learns who
+ * the user is (they signed in) but never their IP address or location.
+ * Tokens live in memory only, never on disk, and New Identity forgets them.
+ *
+ * Configuration comes from the signed app registry (registry.signin.cid), so
+ * a spoofed page cannot redirect sign-in to a look-alike service:
+ *   { "issuer":        "https://id.cumulus.example",
+ *     "authorize_url": "https://id.cumulus.example/authorize",
+ *     "token_url":     "https://id.cumulus.example/token",
+ *     "client_id":     "veil-browser",
+ *     "redirect_uri":  "https://id.cumulus.example/veil/callback" }
+ * Until Cumulus://ID publishes these, the registry has no "cid" block and
+ * Sign In opens the Cumulus://ID page instead (see VeilSignIn).
+ */
+
+export class CumulusIDError extends Error {}
+
+export const SCOPE = "openid profile";
+export const PENDING_TTL_MS = 10 * 60 * 1000;   // a sign-in must finish within 10 minutes
+export const CLOCK_SKEW_S = 120;
+
+const FIELDS = ["issuer", "authorize_url", "token_url", "client_id", "redirect_uri"];
+
+const LOOPBACK = new Set(["localhost", "127.0.0.1", "[::1]"]);
+
+/**
+ * Validate the "cid" block from the registry. allowLoopbackHttp lets the
+ * local prototype use http://localhost; the real browser never sets it.
+ */
+export function readConfig(registry, { allowLoopbackHttp = false } = {}) {
+  const cid = registry && registry.signin && registry.signin.cid;
+  if (!cid) return null;
+  for (const f of FIELDS) {
+    if (typeof cid[f] !== "string" || !cid[f]) throw new CumulusIDError(`cid.${f} is missing`);
+  }
+  for (const f of ["issuer", "authorize_url", "token_url", "redirect_uri"]) {
+    const u = new URL(cid[f]);
+    const loopbackOk = allowLoopbackHttp && u.protocol === "http:" && LOOPBACK.has(u.hostname);
+    if ((u.protocol !== "https:" && !loopbackOk) || u.username || u.password) {
+      throw new CumulusIDError(`cid.${f} must be a plain https:// address`);
+    }
+  }
+  return { ...cid };
+}
+
+const b64url = bytes =>
+  btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+
+function b64urlDecode(text) {
+  const pad = "=".repeat((4 - (text.length % 4)) % 4);
+  const bin = atob(text.replace(/-/g, "+").replace(/_/g, "/") + pad);
+  return new TextDecoder().decode(Uint8Array.from(bin, c => c.charCodeAt(0)));
+}
+
+const randomToken = crypto => b64url(crypto.getRandomValues(new Uint8Array(32)));
+
+export async function pkceChallenge(verifier, crypto = globalThis.crypto) {
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(verifier));
+  return b64url(new Uint8Array(digest));
+}
+
+/** Read the claims of an ID token (structure only; see checkClaims). */
+export function decodeIdToken(jwt) {
+  const parts = typeof jwt === "string" ? jwt.split(".") : [];
+  if (parts.length !== 3) throw new CumulusIDError("ID token is malformed");
+  try {
+    return JSON.parse(b64urlDecode(parts[1]));
+  } catch {
+    throw new CumulusIDError("ID token payload is unreadable");
+  }
+}
+
+/**
+ * Check ID token claims. The token comes straight from the token endpoint
+ * over TLS, which OpenID Connect Core 3.1.3.7 allows in place of checking its
+ * signature; issuer, audience, expiry and nonce are always checked.
+ */
+export function checkClaims(claims, { issuer, clientId, nonce, nowS }) {
+  if (claims.iss !== issuer) throw new CumulusIDError("ID token is from the wrong issuer");
+  const aud = Array.isArray(claims.aud) ? claims.aud : [claims.aud];
+  if (!aud.includes(clientId)) throw new CumulusIDError("ID token is not for VEIL");
+  if (aud.length > 1 && claims.azp !== clientId) throw new CumulusIDError("ID token azp is not VEIL");
+  if (typeof claims.exp !== "number" || claims.exp + CLOCK_SKEW_S < nowS) throw new CumulusIDError("ID token has expired");
+  if (typeof claims.iat === "number" && claims.iat - CLOCK_SKEW_S > nowS) throw new CumulusIDError("ID token is from the future");
+  if (claims.nonce !== nonce) throw new CumulusIDError("ID token nonce does not match");
+  if (typeof claims.sub !== "string" || !claims.sub) throw new CumulusIDError("ID token has no subject");
+}
+
+export class CumulusID {
+  /**
+   * deps: { registry, openTab(url, opts), fetch(url, init), now(), crypto }
+   * fetch must be the browser's own fetch, which goes over Tor.
+   */
+  constructor({ registry, openTab, fetch, now = () => Date.now(), crypto = globalThis.crypto, allowLoopbackHttp = false }) {
+    this.config = readConfig(registry, { allowLoopbackHttp });
+    this.openTab = openTab;
+    this.fetch = fetch;
+    this.now = now;
+    this.crypto = crypto;
+    this.pending = null;
+    this.session = null;      // { sub, name, idToken, accessToken, expiresAt } in memory only
+  }
+
+  get enabled() {
+    return this.config !== null;
+  }
+
+  /** Step 1: open the Cumulus://ID sign-in page. Returns the address opened. */
+  async start() {
+    if (!this.enabled) throw new CumulusIDError("Cumulus://ID is not configured in this build");
+    const verifier = randomToken(this.crypto);
+    const state = randomToken(this.crypto);
+    const nonce = randomToken(this.crypto);
+    const challenge = await pkceChallenge(verifier, this.crypto);
+    this.pending = { verifier, state, nonce, startedAt: this.now() };
+
+    const url = new URL(this.config.authorize_url);
+    url.search = new URLSearchParams({
+      response_type: "code",
+      client_id: this.config.client_id,
+      redirect_uri: this.config.redirect_uri,
+      scope: SCOPE,
+      state,
+      nonce,
+      code_challenge: challenge,
+      code_challenge_method: "S256",
+    }).toString();
+    this.openTab(url.href, { inBackground: false, relatedToCurrent: true });
+    return url.href;
+  }
+
+  /** True if a navigation is the Cumulus://ID redirect back to VEIL. */
+  isRedirect(address) {
+    if (!this.enabled) return false;
+    try {
+      const u = new URL(address);
+      const r = new URL(this.config.redirect_uri);
+      return u.origin === r.origin && u.pathname === r.pathname;
+    } catch {
+      return false;
+    }
+  }
+
+  /** Steps 2-3: finish sign-in from the redirect address. Returns the account. */
+  async handleRedirect(address) {
+    if (!this.isRedirect(address)) throw new CumulusIDError("not the Cumulus://ID redirect address");
+    const pending = this.pending;
+    this.pending = null;                       // one use only, success or failure
+    if (!pending) throw new CumulusIDError("no sign-in was started");
+    if (this.now() - pending.startedAt > PENDING_TTL_MS) throw new CumulusIDError("sign-in took too long; try again");
+
+    const params = new URL(address).searchParams;
+    if (params.get("state") !== pending.state) throw new CumulusIDError("sign-in state does not match");
+    if (params.get("error")) throw new CumulusIDError(`Cumulus://ID refused sign-in: ${params.get("error")}`);
+    const code = params.get("code");
+    if (!code) throw new CumulusIDError("Cumulus://ID returned no code");
+
+    const response = await this.fetch(this.config.token_url, {
+      method: "POST",
+      headers: { "Content-Type": "application/x-www-form-urlencoded", Accept: "application/json" },
+      body: new URLSearchParams({
+        grant_type: "authorization_code",
+        code,
+        redirect_uri: this.config.redirect_uri,
+        client_id: this.config.client_id,
+        code_verifier: pending.verifier,
+      }).toString(),
+      credentials: "omit",
+      referrerPolicy: "no-referrer",
+    });
+    if (!response.ok) throw new CumulusIDError(`token request failed (${response.status})`);
+    const tokens = await response.json();
+    if (!tokens || typeof tokens.id_token !== "string") throw new CumulusIDError("no ID token returned");
+
+    const claims = decodeIdToken(tokens.id_token);
+    const nowS = Math.floor(this.now() / 1000);
+    checkClaims(claims, { issuer: this.config.issuer, clientId: this.config.client_id, nonce: pending.nonce, nowS });
+
+    const name = [claims.name, claims.preferred_username, claims.email]
+      .find(v => typeof v === "string" && v.trim()) || "";
+    this.session = {
+      sub: claims.sub,
+      name: name.slice(0, 64),
+      idToken: tokens.id_token,
+      accessToken: typeof tokens.access_token === "string" ? tokens.access_token : null,
+      expiresAt: claims.exp * 1000,
+    };
+    return { signedIn: true, name: this.session.name };
+  }
+
+  signedIn() {
+    return this.session !== null && this.session.expiresAt > this.now();
+  }
+
+  /** Sign out, and New Identity: forget everything. */
+  forget() {
+    this.pending = null;
+    this.session = null;
+  }
+}
diff --git a/browser/components/veil/VeilSidePanel.sys.mjs b/browser/components/veil/VeilSidePanel.sys.mjs

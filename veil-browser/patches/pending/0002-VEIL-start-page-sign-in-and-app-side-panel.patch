+  <footer><span>AI-powered. Blockchain-governed&#8482;.</span><span class="footer-right"><span class="footer-links" id="footer-links"></span><span class="quiet">&#169; 2026 Infinitum Corporation</span></span></footer>
+  <script src="../shared/bridge.js"></script>

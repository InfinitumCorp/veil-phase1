+       list ships inside the browser and changes only through signed updates.
+       The only external action is a search the user submits themselves. -->
+  <meta http-equiv="Content-Security-Policy"
+        content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; form-action https://duckduckgogg42xjoc72x3sjasowoarfbgcmvfimaftt6twagswzczad.onion; base-uri 'none'">
